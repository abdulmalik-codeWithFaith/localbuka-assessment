{
  "expo": {
    "name": "LocalBuka",
    "slug": "localbuka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "localbuka",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalBuka uses your location only to confirm you are at the restaurant when you check in."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localbuka.app"
    },
    "android": {
      "package": "com.localbuka.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
